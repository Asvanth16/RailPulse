generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PASSENGER
  TRAIN_OPERATOR
  TICKET_INSPECTOR
  STATION_MANAGER
  ADMIN
  SUPER_ADMIN
}

model User {
  id           String    @id @default(cuid())

  firstName    String
  lastName     String

  email        String    @unique
  passwordHash String

  role         UserRole  @default(PASSENGER)

  phoneNumber  String?   @unique

  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum TrainType {
  ICE
  IC
  EC
  RE
  RB
}

model Train {
  id          String   @id @default(cuid())

  trainNumber String   @unique
  trainName   String
  trainType   TrainType

  operator    String

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Station {
  id          String   @id @default(cuid())

  code        String   @unique
  name        String

  city        String
  state       String
  country     String

  latitude    Float
  longitude   Float

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
