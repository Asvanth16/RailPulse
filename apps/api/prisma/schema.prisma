generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PASSENGER
  TRAIN_OPERATOR
  TICKET_INSPECTOR
  STATION_MANAGER
  ADMIN
  SUPER_ADMIN
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email        String @unique
  passwordHash String

  role UserRole @default(PASSENGER)

  phoneNumber String? @unique

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  favoriteStations FavoriteStation[]
  savedJourneys SavedJourney[]
  recentSearches RecentSearch[]
  alerts Alert[]
  notificationPreference NotificationPreference?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
}

enum TrainType {
  ICE
  IC
  EC
  RE
  RB
}

model Train {
  id String @id @default(cuid())

  trainNumber String    @unique
  trainName   String
  trainType   TrainType

  operator String

  isActive Boolean @default(true)

  journeys Journey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Station {
  id String @id @default(cuid())

  code String @unique
  name String

  city    String
  state   String
  country String

  latitude  Float
  longitude Float

  isActive Boolean @default(true)

  journeyStops JourneyStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
}

enum JourneyStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  DELAYED
  CANCELLED
  COMPLETED
}

model Journey {
  id String @id @default(cuid())

  journeyNumber String @unique

  trainId String
  train   Train  @relation(fields: [trainId], references: [id])

  status JourneyStatus @default(SCHEDULED)

  isActive Boolean @default(true)

  stops JourneyStop[]

  schedules Schedule[]

  trainRuns TrainRun[]
  alerts Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainId])
}

model JourneyStop {
  id String @id @default(cuid())

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id])

  stationId String
  station   Station @relation(fields: [stationId], references: [id])

  sequence Int

  arrivalTime   DateTime?
  departureTime DateTime?

  platform String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([journeyId, sequence])
  @@index([journeyId])
  @@index([stationId])
}

enum ScheduleType {
  DAILY
  WEEKDAYS
  WEEKENDS
  CUSTOM
}

model Schedule {
  id String @id @default(cuid())

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  scheduleType ScheduleType

  monday    Boolean @default(false)
  tuesday   Boolean @default(false)
  wednesday Boolean @default(false)
  thursday  Boolean @default(false)
  friday    Boolean @default(false)
  saturday  Boolean @default(false)
  sunday    Boolean @default(false)

  effectiveFrom  DateTime
  effectiveUntil DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
}

enum TrainRunStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  IN_TRANSIT
  ARRIVED
  COMPLETED
  CANCELLED
}

model TrainRun {
  id String @id @default(cuid())

  journeyId String
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  serviceDate DateTime

  status TrainRunStatus @default(SCHEDULED)

  startedAt   DateTime?
  completedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyId])
  @@index([serviceDate])
}

model FavoriteStation {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stationEva  Int
  stationName String

  createdAt DateTime @default(now())

  @@unique([userId, stationEva])
  @@index([userId])
}

model SavedJourney {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  fromStationEva  Int
  fromStationName String

  toStationEva  Int
  toStationName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])

  @@unique([userId, fromStationEva, toStationEva])
}

enum SearchType {
  STATION
  JOURNEY
}

model RecentSearch {
  id String @id @default(cuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  searchType SearchType

  query String?

  fromStationEva Int?
  fromStationName String?

  toStationEva Int?
  toStationName String?

  createdAt DateTime @default(now())

  @@index([userId])

  @@unique([userId, searchType, query])

  @@unique([userId, searchType, fromStationEva, toStationEva])
}

model NotificationPreference {
  id String @id @default(cuid())

  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  pushNotifications Boolean @default(true)
  emailNotifications Boolean @default(true)

  delayAlerts Boolean @default(true)
  platformChangeAlerts Boolean @default(true)

  departureReminders Boolean @default(true)

  reminderMinutes Int @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AlertType {
  DELAY
  PLATFORM_CHANGE
  CANCELLATION
  DEPARTURE_REMINDER
  ARRIVAL_REMINDER
}

model Alert {
  id String @id @default(cuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainNumber String?

  journeyId String?
  journey Journey? @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  fromStationEva Int?
  fromStationName String?

  toStationEva Int?
  toStationName String?

  monitorStationEva Int?
  monitorStationName String?

  alertType AlertType

  isEnabled Boolean @default(true)
  isTriggered Boolean @default(false)
  lastTriggeredAt DateTime?

  lastCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([journeyId])
  @@index([monitorStationEva])
}